#!/bin/bash
# gensokyo - a bash + tmux cockpit for running several Claude Code sessions side by side.
#
# Targets macOS /bin/bash 3.2: no associative arrays, no mapfile, no ${var,,}.
# Install layout (GENSOKYO_HOME is derived from this script's real path):
#   bin/gensokyo   lib/*.sh (sourced)   share/tmux.conf share/names.txt share/banner.txt share/plugin/
#   vendor/<os>-<arch>/{tmux,jq}   (fetched by scripts/vendor.sh, never committed)
# Runtime state: ~/.local/state/gensokyo   (override: GENSOKYO_STATE_DIR)
# User config:   ~/.config/gensokyo        (override: GENSOKYO_CONFIG_DIR)
# Binaries:      GENSOKYO_TMUX / GENSOKYO_JQ / GENSOKYO_CLAUDE env -> vendor/ -> PATH
#
# Facts about Claude Code (2.1.260) that this script depends on are documented next to
# the code that uses them, so the script stays understandable without external notes.

# shellcheck source-path=SCRIPTDIR   # `shellcheck -x` then follows the lib/*.sh sources below
set -u

VERSION=0.1.0-dev

# ---------------------------------------------------------------- where am I
real_path() {   # follow symlinks to the real file (readlink -f is not on macOS bash 3.2 systems)
  local src=$1 dir
  while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case $src in /*) ;; *) src=$dir/$src ;; esac
  done
  printf '%s/%s\n' "$(cd "$(dirname "$src")" && pwd)" "$(basename "$src")"
}
SELF=$(real_path "${BASH_SOURCE[0]:-$0}")   # BASH_SOURCE so tests can source this file
GENSOKYO_HOME=$(cd "$(dirname "$SELF")/.." && pwd)
SHARE=$GENSOKYO_HOME/share

CONFIG_DIR=${GENSOKYO_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gensokyo}
STATE_DIR=${GENSOKYO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gensokyo}
RES_DIR=$STATE_DIR/residents
SOCKET=${GENSOKYO_SOCKET:-gensokyo}   # tmux -L <socket>; tests use their own
SESSION=gensokyo                       # the one tmux session on that socket
SHRINE_NAME='⛩ gensokyo'              # the shrine window, so the first tab reads like one

# ---------------------------------------------------------------- output helpers
say()  { printf '%s\n' "$*"; }
warn() { printf 'gensokyo: %s\n' "$*" >&2; }
die()  { warn "$@"; exit 1; }

# ---------------------------------------------------------------- environment
# A Claude Code session exports CLAUDECODE, CLAUDE_CODE_CHILD_SESSION, CLAUDE_CODE_SESSION_ID,
# CLAUDE_CODE_MESSAGING_SOCKET/TOKEN, CLAUDE_PID, CLAUDE_EFFORT, CLAUDE_CODE_ENTRYPOINT,
# CLAUDE_CODE_EXECPATH, ... A `claude` started with those inherited treats itself as a child
# session: transcript saving off and absent from `claude agents --json`. gensokyo is often
# run from inside a resident (the handbook skill does that), so scrub them unconditionally
# before starting the tmux server or a resident. CLAUDE_CONFIG_DIR is the user's own choice
# of where Claude Code keeps its settings, not a session marker, and stays.
scrub_env() {
  local v
  for v in $(env | sed -n 's/^\(CLAUDE[A-Za-z0-9_]*\)=.*/\1/p'); do
    [ "$v" = CLAUDE_CONFIG_DIR ] || unset "$v"
  done
}

# ---------------------------------------------------------------- config
CFG_PREFIX=C-Space          # tmux prefix; Claude Code does not use Ctrl+Space
CFG_PERMISSION_MODE=        # default --permission-mode for new residents; empty = Claude Code's default
CFG_COLOR_BAR=#c0392b       # row 1 background (Hakurei red)
CFG_COLOR_BAR_FG=#ffffff
CFG_COLOR_ROW2=#fbeee6      # row 2 background (cream)
CFG_COLOR_ROW2_FG=#7a1f18
CFG_COLOR_AWAIT=#f1c40f     # chip background when a resident awaits you (gold)
CFG_COLOR_BORDER=#7a1f18
CFG_MOUSE=off
CFG_NOTIFY_TOAST=on         # "needs you" channels: tmux message, desktop alert, terminal bell
CFG_NOTIFY_DESKTOP=on
CFG_NOTIFY_BELL=on
CFG_STATUSLINE=own          # the line at the bottom of each pane: own (gensokyo's) or user (your Claude Code statusLine command)

load_config() {
  local line key
  if [ -f "$CONFIG_DIR/config" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case $line in ''|'#'*) continue ;; esac
      key=${line%%=*}
      case $key in
        ''|*[!A-Z_0-9]*) warn "config: ignoring line: $line"; continue ;;
      esac
      eval "CFG_$key=\${line#*=}"
    done < "$CONFIG_DIR/config"
  fi
}

# ---------------------------------------------------------------- binaries
platform() {
  local os arch
  os=$(uname -s) arch=$(uname -m)
  case $os in Darwin) os=macos ;; Linux) os=linux ;; *) os=unsupported ;; esac
  case $arch in arm64|aarch64) arch=arm64 ;; x86_64|amd64) arch=x86_64 ;; *) arch=unsupported ;; esac
  printf '%s-%s\n' "$os" "$arch"
}
PLATFORM=$(platform)

# resolve_bin <name> <env override> <PREFIX>: env -> vendor/<platform>/<name> -> PATH. Sets
# PREFIX_BIN to the path (empty when not found) and PREFIX_FROM to env|vendored|system.
resolve_bin() {
  local cand from
  if [ -n "$2" ]; then cand=$2 from=env
  elif [ -x "$GENSOKYO_HOME/vendor/$PLATFORM/$1" ]; then cand=$GENSOKYO_HOME/vendor/$PLATFORM/$1 from=vendored
  else cand=$(command -v "$1" 2>/dev/null) || cand=; from=system
  fi
  printf -v "${3}_BIN" '%s' "$cand"; printf -v "${3}_FROM" '%s' "$from"
}
set_bins() {
  resolve_bin tmux "${GENSOKYO_TMUX:-}" TMUX
  resolve_bin jq "${GENSOKYO_JQ:-}" JQ
  resolve_bin claude "${GENSOKYO_CLAUDE:-}" CLAUDE
}
tmux_()   { "$TMUX_BIN" -L "$SOCKET" "$@"; }
jq_()     { "$JQ_BIN" "$@"; }
claude_() { "$CLAUDE_BIN" "$@"; }

need_bins() {
  [ -n "$TMUX_BIN" ] || die "tmux not found: run scripts/vendor.sh (or set GENSOKYO_TMUX)"
  [ -n "$JQ_BIN" ]   || die "jq not found: run scripts/vendor.sh (or set GENSOKYO_JQ)"
  [ -n "$CLAUDE_BIN" ] || die "claude not found on PATH: install Claude Code (https://code.claude.com) or set GENSOKYO_CLAUDE"
}

# ver_ge <a> <b>: true when dotted version a >= b (numeric per component, letters ignored:
# 3.7c >= 3.3). The same awk program is in install.sh.
ver_ge() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    gsub(/[^0-9.]/, "", a); gsub(/[^0-9.]/, "", b)
    split(a, x, "."); split(b, y, ".")
    for (i = 1; i <= 3; i++) { p = x[i] + 0; q = y[i] + 0; if (p > q) exit 0; if (p < q) exit 1 }
    exit 0 }'
}

# ---------------------------------------------------------------- the rest lives in lib/
LIB=$GENSOKYO_HOME/lib
# shellcheck source=../lib/records.sh
. "$LIB/records.sh" || exit 1
# shellcheck source=../lib/registry.sh
. "$LIB/registry.sh" || exit 1
# shellcheck source=../lib/server.sh
. "$LIB/server.sh" || exit 1
# shellcheck source=../lib/cockpit.sh
. "$LIB/cockpit.sh" || exit 1
# shellcheck source=../lib/shrine.sh
. "$LIB/shrine.sh" || exit 1
# shellcheck source=../lib/residents.sh
. "$LIB/residents.sh" || exit 1
# shellcheck source=../lib/recall.sh
. "$LIB/recall.sh" || exit 1
# shellcheck source=../lib/hooks.sh
. "$LIB/hooks.sh" || exit 1
# shellcheck source=../lib/telemetry.sh
. "$LIB/telemetry.sh" || exit 1

# ---------------------------------------------------------------- doctor / help / version
cmd_doctor() {
  local v w
  say "gensokyo $VERSION"
  say "  home       $GENSOKYO_HOME"
  say "  platform   $PLATFORM"
  say "  bash       $BASH_VERSION ($BASH)"
  if [ -n "$TMUX_BIN" ]; then
    v=$("$TMUX_BIN" -V 2>/dev/null | sed 's/^tmux //')
    w=; ver_ge "$v" 3.3 || w="  (too old: need >= 3.3, run scripts/vendor.sh)"
    say "  tmux       $v  $TMUX_BIN ($TMUX_FROM)$w"
  else
    say "  tmux       MISSING: run scripts/vendor.sh"
  fi
  if [ -n "$JQ_BIN" ]; then
    v=$("$JQ_BIN" --version 2>/dev/null | sed 's/^jq-//')
    w=; ver_ge "$v" 1.6 || w="  (too old: need >= 1.6, run scripts/vendor.sh)"
    say "  jq         $v  $JQ_BIN ($JQ_FROM)$w"
  else
    say "  jq         MISSING: run scripts/vendor.sh"
  fi
  if [ -n "$CLAUDE_BIN" ]; then
    v=$("$CLAUDE_BIN" --version 2>/dev/null | sed 's/ (Claude Code)//')
    w=; ver_ge "$v" 2.1.224 || w="  (need >= 2.1.224 for cross-session messaging)"
    say "  claude     ${v:-?}  $CLAUDE_BIN ($CLAUDE_FROM)$w"
  else
    say "  claude     MISSING: install Claude Code (https://code.claude.com)"
  fi
  say "  config     $CONFIG_DIR$([ -f "$CONFIG_DIR/config" ] || printf ' (defaults)')"
  say "  state      $STATE_DIR"
  if [ -f "$SHARE/plugin/.claude-plugin/plugin.json" ] && [ -f "$SHARE/plugin/skills/gensokyo/SKILL.md" ]; then
    say "  plugin     $SHARE/plugin (handbook skill: gensokyo)"
  else
    say "  plugin     MISSING: $SHARE/plugin is incomplete; residents will not know the gensokyo commands"
  fi
  # iTerm2 runs tmux in control mode and draws the session as native tabs and panes. Its
  # version comes from the environment it exports (TERM_PROGRAM_VERSION, LC_TERMINAL_VERSION);
  # asking the application over AppleScript would launch it and ask for permission, which a
  # diagnostic must not do. Inside tmux both are inherited from whatever started the server,
  # so this says where the shell came from, not what is drawing this window.
  if [ "${TERM_PROGRAM:-}" = iTerm.app ]; then
    v=${TERM_PROGRAM_VERSION:-${LC_TERMINAL_VERSION:-}}
    w=; [ -z "$v" ] || ver_ge "$v" 3.5 || w="  (too old: need >= 3.5 for native panes)"
    say "  iTerm2     ${v:-version unknown}  this shell came from iTerm2, so 'gensokyo' attaches with native panes$w"
  else
    say "  iTerm2     no (TERM_PROGRAM=${TERM_PROGRAM:-unset}): 'gensokyo' attaches the plain tmux client, $(prefix_label) then ? lists its keys"
  fi
  v="$HOME/Library/Application Support/iTerm2/DynamicProfiles/gensokyo.json"
  if [ -f "$v" ]; then
    say "  profile    installed: $(tilde "$v")"
  else
    say "  profile    not installed: iTerm2 needs the gensokyo profile to show the chips in its status bar and a title bar per pane"
  fi
  v=$(command -v gensokyo 2>/dev/null) || v=
  if [ -z "$v" ]; then
    say "  on PATH    no: run ./install.sh to link ~/.local/bin/gensokyo (residents fall back to \$GENSOKYO_BIN)"
  elif [ "$(real_path "$v")" = "$SELF" ]; then
    say "  on PATH    $v -> this copy"
  else
    say "  on PATH    $v -> a different copy ($(real_path "$v")); residents launched from here use \$GENSOKYO_BIN"
  fi
  say "  prefix     $CFG_PREFIX ($(prefix_label))"
  say "  needs you  toast=$CFG_NOTIFY_TOAST desktop=$CFG_NOTIFY_DESKTOP ($(desktop_notifier)) bell=$CFG_NOTIFY_BELL  (config: NOTIFY_TOAST/NOTIFY_DESKTOP/NOTIFY_BELL=off)"
  [ "$(desktop_notifier)" = osascript ] && say "             macOS asks once to allow notifications from your terminal application; say yes"
  v=''; [ -n "$JQ_BIN" ] && v=$(settings_value "$PWD" '.statusLine.command')
  if [ "$CFG_STATUSLINE" = user ] && [ -n "$v" ]; then
    say "  status line  yours, run by gensokyo after it records the numbers: $v  (config: STATUSLINE=own for gensokyo's)"
  elif [ "$CFG_STATUSLINE" = user ]; then
    say "  status line  gensokyo's own (STATUSLINE=user set, but no statusLine command in your Claude Code settings)"
  else
    say "  status line  gensokyo's own in every pane${v:+  (config: STATUSLINE=user runs yours instead: $v)}"
  fi
  if [ -n "$TMUX_BIN" ] && server_running; then
    say "  server     running (tmux -L $SOCKET), $(count_records) resident record(s)"
    say "  clients    $(client_summary)"
    [ "$(clients_in_mode cc)" -gt 0 ] && [ "$(clients_in_mode tty)" -gt 0 ] &&
      say "             both kinds at once: one status bar serves the whole server, so detach one of them"
    v=$(clock_age)
    if [ -n "$v" ] && [ "$v" -lt 30 ]; then
      say "  clock      ticking (last tick ${v}s ago); it pushes the chips into iTerm2's status bar"
    else
      say "  clock      NOT ticking${v:+ (last tick ${v}s ago)}: the chips will not move; 'gensokyo' starts one"
    fi
    v=$(tmux_ show-environment -g 2>/dev/null | sed -n 's/^\(CLAUDE[A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')
    if [ -n "$v" ]; then
      say "  env        WARNING: server environment carries $v(residents would hide from the registry)"
    else
      say "  env        clean (no CLAUDE* variables in the server environment)"
    fi
  else
    say "  server     not running ('gensokyo' starts it)"
  fi
  v=$(env | sed -n 's/^\(CLAUDE[A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')
  [ -n "$v" ] && say "  shell env  $v- scrubbed before launching anything"
  return 0
}

# Command table: name|alias|arguments|summary. Only shipped commands are listed;
# `help --json` is what the handbook skill reads, so it must not promise more than exists.
command_table() {
  cat <<'EOF'
|||start or attach the cockpit  (--tty: plain tmux client, --detach: server only, --nested: inside another tmux)
new|summon|[dir] [-n name] [-m model] [-e effort] [-p mode]|start a Claude Code session (a resident) in a window of its own
close|banish|<name or slot>|ask a resident to /exit; closes a departed pane
resume|recall|[name or session id] [--json]|bring a departed resident back into a pane; alone: who can be recalled
list|who|[--json] [--all]|residents: slot, state, name, directory; --all adds other sessions
help||[--json]|this list; --json for tools
doctor|||which tmux, jq and claude are in use, versions, server state
version|||print the version
EOF
}

cmd_help() {
  local name alias args summary
  if [ "${1:-}" = --json ]; then
    [ -n "$JQ_BIN" ] || die "jq not found: run scripts/vendor.sh (or set GENSOKYO_JQ)"
    # shellcheck disable=SC2016
    command_table | jq_ -R -s '
      split("\n") | map(select(length > 0) | split("|"))
      | map({name: (if .[0] == "" then "gensokyo" else .[0] end), alias: .[1], args: .[2], summary: .[3]})' \
      | jq_ --arg v "$VERSION" --arg prefix "$CFG_PREFIX" '{version: $v, prefix: $prefix, commands: .}'
    return 0
  fi
  say "gensokyo $VERSION - several Claude Code sessions side by side in tmux"
  say
  say "usage: gensokyo [command] [args]"
  say
  while IFS='|' read -r name alias args summary; do
    if [ -n "$alias" ]; then name="$name ($alias)"; fi
    printf '  %-22s %-36s %s\n' "gensokyo $name" "$args" "$summary"
  done <<EOF
$(command_table)
EOF
  say
  say "keys: $(legend_text)"
}

# ---------------------------------------------------------------- not yet
cmd__not_yet() { warn "'$1' is not available yet"; exit 2; }

# ---------------------------------------------------------------- main
main() {
  load_config
  set_bins
  local cmd=${1:-}
  case $cmd in   # these three work without tmux, jq or claude
    -V|--version|version) say "gensokyo $VERSION"; return 0 ;;
    -h|help) shift; cmd_help "$@"; return 0 ;;
    doctor) cmd_doctor; return 0 ;;
  esac
  need_bins
  case $cmd in
    ''|--*) cmd_home "$@" ;;
    # plain names first; themed verbs are aliases
    new|summon) shift; cmd_new "$@" ;;
    close|banish) shift; cmd_close "$@" ;;
    list|who) shift; cmd_list "$@" ;;
    resume|recall) shift; cmd_resume "$@" ;;
    spell) cmd__not_yet broadcast ;;
    ritual) cmd__not_yet schedule ;;
    broadcast|schedule|update|uninstall) cmd__not_yet "$cmd" ;;
    _shrine|_keys|_run|_hook|_statusline|_bar|_border|_tick|_focus|_menu-shrine|_menu-summon|_popup-summon|_menu-banish|_menu-recall)
      shift; "cmd_$cmd" "$@" ;;
    _menu-spell|_menu-message|_menu-timetable)
      tmux_ display-message "$cmd is not available yet"; exit 0 ;;
    *) die "unknown command: $cmd (see: gensokyo help)" ;;
  esac
}

# tests/run.sh sources this file for its functions; only run main when executed.
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then main "$@"; fi
