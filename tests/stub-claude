#!/bin/bash
# tests/stub-claude - stands in for the `claude` binary so gensokyo can be exercised without
# Claude Code or an Anthropic login. It implements just enough of Claude Code 2.1:
#   --version                 prints a version line: $STUB_STATE/installed if it is there, else
#                             2.1.282, as the claude installed now says
#   agents --json             the registry: $STUB_REGISTRY (a fixture file) if set, else one
#                             entry per running stub session, status from <id>.status; each
#                             call adds a line to agents.calls
#   -p / --print              one headless run: the JSON object of --output-format json, else
#                             the result as plain text. What it answers is set by STUB_P_* (see
#                             below: SLEEP, NOISE, FAIL, ERROR, RESULT, DENY, SESSION, COST, TURNS); every call leaves its arguments in print.args and its
#                             prompt in print.prompt
#   interactive (default)     honours --session-id, --name, --resume, swallows the other launch
#                             flags, sets the window title to "✳ <name>", pushes the keyboard
#                             modes Claude Code pushes, echoes input, /rename <name> renames,
#                             /exit exits 0 - unless <id>.eat-exit says to drop that many first;
#                             /sync <s> draws SYNC-MID, waits <s> seconds, then SYNC-END, all in
#                             one synchronized-output block (2026); /sync 0 waits a moment
#                             /mouse turns on mouse reporting (1000, SGR 1006)
#                             /link <uri> <text> prints <text> as a link to <uri> (OSC 8)
#                             /clear starts a new session id (the files below keep the first)
# /status runs the statusLine command from its --settings as Claude Code does, with the version
# it started as; with STUB_STATUS=1 it also runs it as it starts.
# With STUB_HOOKS=1 it runs the `_hook` command from its --settings as Claude Code does:
# SessionStart at start and on /clear, UserPromptSubmit then Stop ("echo: <line>") for every
# prompt (the one on the command line too), each naming the --permission-mode it was started
# with (else default) as Claude Code names the mode it is in, a permission Notification on /perm
# (the registry says `waiting` until /esc, which dismisses it and ends the turn with no Stop, as
# Esc or a denial does), AskUserQuestion's PreToolUse on /ask <q> and its PostToolUse on /answer.
# /fail is a prompt whose turn ends in StopFailure (an API error); /hang one with no Stop at all,
# busy in the registry until its idle_prompt Notification $STUB_IDLE seconds later (default 2);
# /flood <n> one whose answer is <n> bytes; /busy <s> one whose tools fire PreToolUse every 0.2 s
# for <s> seconds, Ctrl-C or not, as a turn started again by a queued message does; a paste
# meanwhile is queued, with no Stop of its own. With STUB_HOLD=1 the command line's prompt gets no
# Stop until /finish: a run still going.
# Every line read goes to <id>.input as it came. With STUB_WINCH=1 every SIGWINCH writes the
# tty's `rows cols` to <id>.size and prints it; a signal that interrupts `read` loses the part
# of the line read so far, so it is off by default.
# Signals, for banish and sweep tests (Claude Code survives Ctrl-C, and so does the stub):
#   STUB_HUP=exit (default) | ignore | <seconds>   exit on SIGHUP, ignore it, or linger first
#   STUB_TERM=exit (default) | ignore              ignoring SIGTERM too leaves only SIGKILL
#   STUB_DESCENDANT=1         start `sleep 600` in its own session with no tty, as a detached
#                             Bash-tool command is: only a parent-pid walk can find it. Its pid
#                             goes to <id>.descendant
# Every session keeps its registry entry in $STUB_STATE/<session-id>.json, its launch arguments
# in <session-id>.args and its environment in <session-id>.env so tests can assert on them;
# <session-id>.ready appears once its traps are set and it reads input.
# bash 3.2 compatible.

set -u
STUB_STATE=${STUB_STATE:-${GENSOKYO_STATE_DIR:-${TMPDIR:-/tmp}}/stub}
mkdir -p "$STUB_STATE"

# A JSON string, newlines included: a headless run's `result` is prose and runs to several lines.
json_str() {
  printf '%s' "$1" | tr -d '\001-\010\013-\037' | tr '\011' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'
}

# Claude Code keeps a conversation only once a prompt is submitted, and cannot resume any other.
convo() { printf '%s' "${CLAUDE_CONFIG_DIR:-$STUB_STATE/claude}/projects/stub/$1.jsonl"; }
submitted() { mkdir -p "$(dirname "$(convo "$session")")"; printf '%s\n' "$1" >> "$(convo "$session")"; }

write_entry() {   # <id> <name> <status>; whole, so a registry read never sees half of it
  printf '{"pid": %s, "cwd": "%s", "kind": "interactive", "startedAt": %s000, "sessionId": "%s", "name": "%s", "status": %s}\n' \
    "$$" "$(json_str "$PWD")" "$STARTED" "$1" "$(json_str "$2")" "$3" > "$STUB_STATE/$1.json.tmp"
  mv "$STUB_STATE/$1.json.tmp" "$STUB_STATE/$1.json"
}

installed() { cat "$STUB_STATE/installed" 2>/dev/null || echo 2.1.282; }

case ${1:-} in
  --version) echo "$(installed) (Claude Code)"; exit 0 ;;
  agents)
    [ -d "${STUB_STATE:-}" ] && echo . >>"$STUB_STATE/agents.calls"
    if [ -n "${STUB_REGISTRY:-}" ]; then cat "$STUB_REGISTRY"; exit 0; fi
    printf '['
    sep=
    for f in "$STUB_STATE"/*.json; do
      [ -f "$f" ] || continue
      pid=$(sed -n 's/^{"pid": \([0-9]*\),.*/\1/p' "$f")
      [ -n "$pid" ] || continue
      kill -0 "$pid" 2>/dev/null || { rm -f "$f"; continue; }
      id=${f##*/}; id=${id%.json}
      st=idle; [ -f "$STUB_STATE/$id.status" ] && st=$(cat "$STUB_STATE/$id.status")
      case $st in null) st=null ;; *) st="\"$st\"" ;; esac
      printf '%s' "$sep"; sed "s/\"status\": [^}]*}/\"status\": $st}/" "$f" | tr -d '\n'
      sep=,
    done
    printf ']\n'
    exit 0 ;;
esac

# -p / --print: the headless run. Looked for before the `--`, because the prompt after it is
# somebody's prose and may say anything at all.
printing=''
for a in "$@"; do
  case $a in --) break ;; -p|--print) printing=1; break ;; esac
done
if [ -n "$printing" ]; then
  fmt=text prompt=''
  printf '%s\n' "$*" > "$STUB_STATE/print.args"
  while [ $# -gt 0 ]; do
    case $1 in
      --output-format) fmt=$2; shift ;;
      --) shift; prompt=$*; break ;;
    esac
    shift
  done
  printf '%s' "$prompt" > "$STUB_STATE/print.prompt"
  # The knobs a test turns. Every one of them is a real answer from `claude -p`: a run that
  # worked, one whose tools were refused with nobody there to ask, one that failed before it
  # started, and one still going when something else asks whether it is.
  [ -n "${STUB_P_SLEEP:-}" ] && sleep "$STUB_P_SLEEP"
  # A run that writes this many bytes to stderr.
  [ -n "${STUB_P_NOISE:-}" ] && head -c "$STUB_P_NOISE" /dev/zero | tr '\0' x >&2
  # A tool or MCP server that outlives the run, in its process group.
  if [ -n "${STUB_P_LEAVE:-}" ]; then
    sleep 300 </dev/null >/dev/null 2>&1 &
    echo $! > "$STUB_STATE/left.pid"
  fi
  if [ -n "${STUB_P_FAIL:-}" ]; then
    echo "stub-claude: $STUB_P_FAIL" >&2
    exit 1
  fi
  # As a bad --model does: the object, saying it failed, and exit 1.
  if [ -n "${STUB_P_ERROR:-}" ]; then
    echo "Warning: something on stderr" >&2
    printf '{"type": "result", "subtype": "success", "is_error": true, "result": "%s", "num_turns": 1}\n' \
      "$(json_str "$STUB_P_ERROR")"
    exit 1
  fi
  result=${STUB_P_RESULT:-"stub -p ran in $PWD
prompt was $(printf '%s' "$prompt" | grep -c '') lines"}
  denials='[]'
  [ -n "${STUB_P_DENY:-}" ] &&
    denials="[{\"tool_name\": \"$STUB_P_DENY\", \"tool_use_id\": \"toolu_stub\", \"tool_input\": {}}]"
  if [ "$fmt" = json ]; then
    printf '{"type": "result", "subtype": "success", "is_error": false, "result": "%s", ' \
      "$(json_str "$result")"
    printf '"session_id": "%s", "total_cost_usd": %s, "num_turns": %s, "duration_ms": 12, ' \
      "${STUB_P_SESSION:-11111111-2222-3333-4444-555555555555}" "${STUB_P_COST:-0.0123}" \
      "${STUB_P_TURNS:-2}"
    printf '"stop_reason": "end_turn", "terminal_reason": "completed", "permission_denials": %s}\n' \
      "$denials"
  else
    printf '%s\n' "$result"
  fi
  exit 0
fi

# interactive
ORIG_ARGS=$*
id='' name=stub prompt='' resume='' hook_cmd='' status_cmd='' mode=default
while [ $# -gt 0 ]; do
  case $1 in
    --session-id) id=$2; shift ;;
    --resume) id=$2; resume=1; shift ;;
    --name) name=$2; shift ;;
    --settings) hook_cmd=$(printf '%s' "$2" | sed -n 's/.*"command":"\([^"]*_hook\)".*/\1/p')
                status_cmd=$(printf '%s' "$2" | sed -n 's/.*"command":"\([^"]*_statusline[^"]*\)".*/\1/p'); shift ;;
    --permission-mode) mode=$2; shift ;;
    --plugin-dir|--append-system-prompt|--model|--effort|--mcp-config) shift ;;
    --) shift; prompt=$*; break ;;
    *) ;;
  esac
  shift
done
[ -n "$id" ] || id=stub-$$
session=$id
[ -n "$resume" ] && [ ! -f "$(convo "$id")" ] && { echo "No conversation found with session ID: $id" >&2; exit 1; }
[ -n "$resume" ] && [ -f "$STUB_STATE/$id.name" ] && name=$(cat "$STUB_STATE/$id.name")
STARTED=$(date +%s)
# What this process is: an update on disk does not change it.
VERSION=$(installed)
printf '%s\n' "$ORIG_ARGS" > "$STUB_STATE/$id.args"
env > "$STUB_STATE/$id.env"
printf '%s\n' "$name" > "$STUB_STATE/$id.name"
rm -f "$STUB_STATE/$id.status"
write_entry "$session" "$name" '"idle"'

# fire <event> [,"more": "json"]: one hook, the way Claude Code runs it.
fire() {
  [ -n "${STUB_HOOKS:-}" ] && [ -n "$hook_cmd" ] || return 0
  printf '{"hook_event_name": "%s", "session_id": "%s"%s}' "$1" "$session" "${2:-}" | sh -c "$hook_cmd"
}

# The status line's JSON, as much of it as gensokyo reads that the stub can say.
status() {
  [ -n "$status_cmd" ] || return 0
  printf '{"session_id": "%s", "version": "%s", "model": {"display_name": "Stub"}}' "$session" "$VERSION" |
    sh -c "$status_cmd" >/dev/null
}

esc=$(printf '\033')
leave() { printf '%s[?2004l' "$esc"; rm -f "$STUB_STATE/$session.json"; }
trap leave EXIT
# Ignored, not trapped: bash 3.2 can lose the last character of every later line when a trapped
# SIGINT lands as `read` starts. The tty still throws away a half-typed line on Ctrl-C.
trap '' INT
winch() { stty size > "$STUB_STATE/$id.size.tmp"; mv "$STUB_STATE/$id.size.tmp" "$STUB_STATE/$id.size"
          echo "size $(cat "$STUB_STATE/$id.size")"; }
[ -n "${STUB_WINCH:-}" ] && trap winch WINCH
case ${STUB_HUP:-exit} in
  exit) trap 'exit 129' HUP ;;
  ignore) trap : HUP ;;
  *) trap 'echo "stub-claude: HUP, leaving in ${STUB_HUP}s"; sleep "$STUB_HUP"; exit 129' HUP ;;
esac
case ${STUB_TERM:-exit} in
  ignore) trap : TERM ;;
  *) trap 'exit 143' TERM ;;
esac

if [ -n "${STUB_DESCENDANT:-}" ]; then
  perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' sleep 600 </dev/null >/dev/null 2>&1 &
  echo $! > "$STUB_STATE/$id.descendant"
fi

# Claude Code pushes kitty keyboard flags 5, then modifyOtherKeys 2, and does it twice.
printf '%s[>5u%s[>4;2m%s[>5u%s[>4;2m' "$esc" "$esc" "$esc" "$esc"
printf '%s]2;✳ %s\007' "$esc" "$name"
echo "stub-claude $name ($id)${resume:+ resumed}"
echo "env CLAUDE*: $(env | sed -n 's/^\(CLAUDE[A-Za-z0-9_]*\)=.*/\1/p' | grep -c -v -x CLAUDE_CONFIG_DIR)"
echo "env TERM=${TERM:-} COLORTERM=${COLORTERM:-} TERM_PROGRAM=${TERM_PROGRAM:-} GENSOKYO_RESIDENT=${GENSOKYO_RESIDENT:-}"
# What the skills tell a resident to type. A resident that cannot resolve it goes looking for
# the binary, so whoever launched it must have put it on PATH.
echo "gensokyo on PATH: $(command -v gensokyo || echo no)"
if [ -n "$resume" ]; then fire SessionStart ', "source": "resume"'; else fire SessionStart ', "source": "startup"'; fi
[ -n "${STUB_STATUS:-}" ] && status
if [ -n "$prompt" ]; then
  fire UserPromptSubmit ", \"permission_mode\": \"$mode\", \"prompt\": \"$(json_str "$prompt")\""
  echo "> $prompt"; submitted "$prompt"
  [ -n "${STUB_HOLD:-}" ] || fire Stop ', "permission_mode": "'"$mode"'", "last_assistant_message": "done"'
fi

# Bracketed paste, because a spell card depends on it: a paste is wrapped in \033[200~ and
# \033[201~ only if the program asked for it, and the real thing does. The whole card then
# arrives as one block, shows as a collapsed "[Pasted text #1 +7 lines]" and submits when Enter
# comes, in one prompt. Read line by line instead, a card would echo as one prompt per line,
# interleaved with the keystrokes still arriving - nothing like what a resident does.
pstart="${esc}[200~" pend="${esc}[201~"
printf '%s[?2004h' "$esc"
pasted='' pastes=0
: > "$STUB_STATE/$id.ready"   # traps set, reading input
while :; do
  IFS= read -r line; rc=$?
  if [ "$rc" -ne 0 ]; then [ "$rc" -gt 128 ] && continue; break; fi   # a trapped signal: keep going
  printf '%s\n' "$line" >> "$STUB_STATE/$id.input"
  case $line in
    *"$pstart"*)
      # Whatever was typed before the paste stays in front of it, as a half-typed prompt does
      # in Claude Code's input line: the two go in as one prompt.
      typed=${line%%"$pstart"*}
      pasted=${line#*"$pstart"}
      while :; do
        case $pasted in *"$pend"*) break ;; esac
        IFS= read -r more || break
        printf '%s\n' "$more" >> "$STUB_STATE/$id.input"
        pasted="$pasted
$more"
      done
      pasted=${pasted%"$pend"*}
      pastes=$((pastes + 1))
      lines=$(printf '%s\n' "$pasted" | grep -c '')
      if [ "$lines" -gt 1 ]; then
        printf '%s[Pasted text #%s +%s lines]\n' "$typed" "$pastes" "$((lines - 1))"
      else
        printf '%s%s\n' "$typed" "$pasted"   # a one-liner arrives literally, as in Claude Code
      fi
      # Then submit it, as one prompt however many lines it holds. Claude Code holds a paste
      # until Enter and this cannot: the tty here is line-buffered, so the newline that finishes
      # the paste *is* the Enter that was sent after it, already consumed as this line's
      # terminator. What this stub checks is the part that can go wrong silently - that the
      # card arrives whole.
      printf '%s%s\n' "$typed" "$pasted" | sed 's/^/> /'
      fire UserPromptSubmit ", \"permission_mode\": \"$mode\", \"prompt\": \"$(json_str "$typed$pasted")\""
      # Mid-turn it is queued behind the turn, which goes on: no Stop of its own.
      [ -f "$STUB_STATE/$id.turn" ] || fire Stop ', "permission_mode": "'"$mode"'", "last_assistant_message": "pasted"'
      pasted=''
      continue ;;
  esac
  case $line in
    /exit)
      # A keystroke lost on demand. `close` and `quit` have to notice that a resident never
      # heard the /exit and ask again; the real thing is a timing flake no test can summon.
      # `<id>.eat-exit` says how many /exits to drop, and drops them the way the flake does:
      # one character short, so nothing matches and the resident sits there.
      if [ -f "$STUB_STATE/$id.eat-exit" ] && [ "$(cat "$STUB_STATE/$id.eat-exit")" -gt 0 ]; then
        printf '%s\n' "$(( $(cat "$STUB_STATE/$id.eat-exit") - 1 ))" > "$STUB_STATE/$id.eat-exit"
        echo "> ${line%?}"
        continue
      fi
      echo "Resume this session with: claude --resume \"$name\""; exit 0 ;;
    # Stops echoing what is typed, as a dialog that swallows a paste would.
    /mute) stty -echo; echo muted; sleep 30 ;;
    # Draws a while after it is typed, with no hook, as a turn nobody here started would.
    /later) (sleep 4; echo "later") & ;;
    # Draws over the line being typed <s> seconds on, with no hook, as a dialog draws over
    # Claude Code's input line before any hook or the registry tells of it.
    /cover\ *) (sleep "${line#/cover }"; printf '\r%s[2KDo you want to proceed?' "$esc") & ;;
    /status) status; echo "status $VERSION" ;;
    /mouse) printf '%s[?1000h%s[?1006h' "$esc" "$esc"; echo "mouse on" ;;
    /link\ *) set -- ${line#/link }; printf '%s]8;;%s%s\\%s%s]8;;%s\\\n' "$esc" "$1" "$esc" "$2" "$esc" "$esc" ;;
    /clear) rm -f "$STUB_STATE/$session.json"; session=$(uuidgen | tr 'A-Z' 'a-z')
            write_entry "$session" "$name" '"idle"'; fire SessionStart ', "source": "clear"'; echo "cleared" ;;
    /perm) printf 'waiting\n' > "$STUB_STATE/$session.status"
           fire Notification ', "notification_type": "permission_prompt", "message": "Claude needs your permission"'; echo "asked permission" ;;
    /esc) printf 'idle\n' > "$STUB_STATE/$session.status"; echo "dismissed" ;;
    /fail) fire UserPromptSubmit ', "permission_mode": "'"$mode"'", "prompt": "/fail"'; echo "> /fail"; submitted "$line"
           fire StopFailure ', "error": "rate_limit", "error_details": "429"'; echo "API Error: rate limited" ;;
    /hang) printf 'busy\n' > "$STUB_STATE/$session.status"
           fire UserPromptSubmit ', "permission_mode": "'"$mode"'", "prompt": "/hang"'; echo "> /hang"; submitted "$line"
           ( sleep "${STUB_IDLE:-2}"; printf 'idle\n' > "$STUB_STATE/$session.status"
             fire Notification ', "notification_type": "idle_prompt", "message": "Claude is waiting for your input"' ) & ;;
    /flood\ *) n=${line#/flood }
               fire UserPromptSubmit ', "permission_mode": "'"$mode"'", "prompt": "/flood"'; echo "> $line"; submitted "$line"
               fire Stop ", \"permission_mode\": \"$mode\", \"last_assistant_message\": \"flood $n\\n$(head -c "$n" /dev/zero | tr '\0' x)\""
               echo "flooded $n" ;;
    /ask\ *) fire PreToolUse ", \"tool_name\": \"AskUserQuestion\", \"tool_input\": {\"questions\": [{\"question\": \"$(json_str "${line#/ask }")\"}]}"; echo "asked" ;;
    /answer) fire PostToolUse ', "tool_name": "AskUserQuestion"'; echo "answered" ;;
    /busy\ *) fire UserPromptSubmit ', "permission_mode": "'"$mode"'", "prompt": "/busy"'; echo "> $line"; submitted "$line"
             : > "$STUB_STATE/$id.turn"
             ( n=$(( ${line#/busy } * 5 )); while [ $n -gt 0 ]; do n=$((n - 1)); sleep 0.2
               fire PreToolUse ', "tool_name": "Bash", "tool_input": {}'; done; rm -f "$STUB_STATE/$id.turn" ) & ;;
    /finish) fire Stop ', "permission_mode": "'"$mode"'", "last_assistant_message": "finished"'; echo "finished" ;;
    # `/sync 0` parts the two writes by a few milliseconds of builtins: a `sleep` to fork and
    # exec can take longer than the daemon's hold on a loaded runner.
    /sync\ 0) printf '%s[?2026hSYNC-MID\n' "$esc"; n=0; while [ $n -lt 3000 ]; do n=$((n + 1)); done
               printf 'SYNC-END\n%s[?2026l' "$esc" ;;
    /sync\ *) printf '%s[?2026hSYNC-MID\n' "$esc"; sleep "${line#/sync }"
               printf 'SYNC-END\n%s[?2026l' "$esc" ;;
    /rename\ *) name=${line#/rename }; printf '%s\n' "$name" > "$STUB_STATE/$id.name"
                write_entry "$session" "$name" '"idle"'; printf '%s]2;✳ %s\007' "$esc" "$name"; echo "renamed to $name" ;;
    *) fire UserPromptSubmit ", \"permission_mode\": \"$mode\", \"prompt\": \"$(json_str "$line")\""
       echo "> $line"; submitted "$line"
       fire Stop ", \"permission_mode\": \"$mode\", \"last_assistant_message\": \"echo: $(json_str "$line")\"" ;;
  esac
done
exit 0
