#!/bin/bash
# tests/stub-codex - stands in for the `codex` binary so gensokyo can run a Codex resident without
# Codex or an OpenAI login. It implements just enough of codex-cli 0.154:
#   --version                 prints codex-cli 0.154.0-alpha.6.2
#   queue --thread <id> --message <text>
#                             queues <text> for the interactive stub on that thread, which runs
#                             it as a prompt once it is idle, but not after an interrupted turn
#                             until a prompt typed in starts one (<thread>.held, so a resume
#                             holds it too); prints "Queued message ..." as codex does. Its
#                             argv, each arg ended by a NUL, is queue.args.
#                             --thread=<id> and --message=<text> too; a value after its flag
#                             that starts with `-` is refused as an argument, as codex's parser
#                             does. With queue.fail there it queues nothing: its text goes to
#                             stderr and it exits 1, as codex does while an app-server runs
#   exec [flags] -- <prompt>  `codex exec --json -o <file>`: its argv, each arg ended by a NUL, in
#                             exec.args and what it read on stdin in exec.stdin; prints the
#                             events of one turn as JSONL, a warning among them as an error
#                             item, and writes "stub exec ran in <dir>: <prompt's first line>" to
#                             the -o file. STUB_EXEC_FAIL=<text> fails the turn with it
#                             (turn.failed, the text on stderr too, exit 1); STUB_EXEC_CUT=1
#                             exits 0 before the turn completes
#   [flags] resume <thread>   starts on that thread, the flags before or after it: its first
#                             SessionStart says "resume", and comes with its first prompt, as
#                             Codex sends it, none while it waits for one
#   interactive (default)     takes the prompt after `--` (or a bare word), swallows the other
#                             launch flags, `-m` sets the hooks' model
# Hooks: every `-c hooks.<Event>=[{hooks=[{type="command",command="..."}]}]` is run with `sh -c`
# and Codex's JSON payload on stdin, but only with --dangerously-bypass-hook-trust, as Codex
# runs flag hooks only then. SessionStart ("startup") fires with the first prompt, not at start,
# and writes the thread's rollout, empty, where Codex keeps it: under $CODEX_HOME/sessions/;
# every prompt fires UserPromptSubmit, works for $STUB_WORK seconds (default 1, tenths allowed),
# then fires Stop with "echo: <prompt>". The prompt /perm opens an approval instead: PreToolUse
# and PermissionRequest for a Bash command with a description, with three choices; y, or Enter on
# the first two, grants it (PostToolUse, whose tool_input has no description, as Codex sends it;
# then the turn goes on to its Stop); Esc, n, or Enter on the third refuses it (Interrupt, no
# Stop). Up and Down move between the choices. SessionEnd ("other") fires on leaving, whether or
# not a session started.
# Title, only with `-c tui.terminal_title=...`, by OSC 0 as Codex draws it: "Ready | Context 0%
# used", then "Ready | <id cut to 29>... | ...", "Starting | ...", then Ready or Working, each held
# for a moment so a poller sees it. A turn draws Working frames with a spinner glyph, through an
# approval too. A Stop draws one more Working frame, its glyph gone, before Ready; an Interrupt
# one more with its glyph, then Ready frames whose glyph keeps turning. That last Working frame
# stays $STUB_TAIL seconds (default 0.2), long enough with a few for the daemon to read it.
# Keys, read a byte at a time with the tty's ISIG off: Esc at an idle prompt does nothing and
# keeps the draft; Esc or Ctrl-C in a turn interrupts it; Ctrl-C clears a draft, or on an empty
# prompt quits at once (exit 0); /exit + Enter exits 0; Enter on an empty prompt does nothing.
# Kitty-encoded Esc, Enter and Ctrl-C count too, focus reports are ignored, a bracketed paste
# goes into the draft whole. It pushes the modes Codex pushes and pops them on the way out.
# Every session keeps, keyed by $GENSOKYO_RESIDENT, its launch arguments in <resident>.args (each
# ended by a NUL), its environment in <resident>.env, its thread id in <resident>.thread and
# every byte it reads in <resident>.input; <resident>.ready appears once it reads input.
# bash 3.2 compatible.

set -u
STUB_STATE=${STUB_STATE:-${GENSOKYO_STATE_DIR:-${TMPDIR:-/tmp}}/stub}
mkdir -p "$STUB_STATE"

# The inside of a JSON string, exactly: a prompt may hold quotes, backslashes and newlines.
json() {
  printf '%s' "$1" | perl -0777 -pe 's/(["\\])/\\$1/g; s/\n/\\n/g; s/\t/\\t/g; s/\r/\\r/g; s/([\x00-\x1f\x7f])/sprintf("\\u%04x", ord $1)/ge'
}
uuid() { uuidgen | tr 'A-Z' 'a-z'; }

case ${1:-} in
  --version) echo "codex-cli 0.154.0-alpha.6.2"; exit 0 ;;
  queue)
    printf '%s\0' "$@" > "$STUB_STATE/queue.args"
    thread='' msg=''
    shift
    while [ $# -gt 0 ]; do
      case $1 in
        --thread=*) thread=${1#--thread=} ;;
        --message=*) msg=${1#--message=} ;;
        --thread|--message)
          case ${2:-} in -*)
            printf "error: unexpected argument '%s' found\n" "${2:-}" >&2; exit 2 ;;
          esac
          [ "$1" = --thread ] && thread=$2 || msg=$2; shift ;;
      esac
      shift
    done
    if [ -f "$STUB_STATE/queue.fail" ]; then cat "$STUB_STATE/queue.fail" >&2; exit 1; fi
    printf '%s\0' "$msg" >> "$STUB_STATE/$thread.queue"
    echo "Queued message $(uuid) for thread $thread."
    exit 0 ;;
esac

if [ "${1:-}" = exec ]; then
  shift
  printf '%s\0' "$@" > "$STUB_STATE/exec.args"
  if [ -t 0 ]; then : > "$STUB_STATE/exec.stdin"; else cat > "$STUB_STATE/exec.stdin"; fi
  out='' prompt=''
  while [ $# -gt 0 ]; do
    case $1 in
      -o|--output-last-message) shift; out=${1:-} ;;
      --) shift; prompt=$*; break ;;
      -m|-s|-c|-p|--add-dir|-C|--cd) shift ;;
    esac
    shift
  done
  printf '{"type":"thread.started","thread_id":"%s"}\n{"type":"turn.started"}\n' "$(uuid)"
  printf '{"type":"item.completed","item":{"id":"item_0","type":"error","message":"a warning"}}\n'
  if [ -n "${STUB_EXEC_FAIL:-}" ]; then
    echo "stub-codex: $STUB_EXEC_FAIL" >&2
    printf '{"type":"turn.failed","error":{"message":"%s"}}\n' "$(json "$STUB_EXEC_FAIL")"
    exit 1
  fi
  said="stub exec ran in $PWD: ${prompt%%$'\n'*}"
  printf '{"type":"item.completed","item":{"id":"item_1","type":"agent_message","text":"%s"}}\n' "$(json "$said")"
  [ -z "${STUB_EXEC_CUT:-}" ] || exit 0
  [ -z "$out" ] || printf '%s\n' "$said" > "$out"
  printf '{"type":"turn.completed","usage":{"input_tokens":120,"cached_input_tokens":0,"output_tokens":7}}\n'
  exit 0
fi

res=${GENSOKYO_RESIDENT:-stub-$$}
printf '%s\0' "$@" > "$STUB_STATE/$res.args"
env > "$STUB_STATE/$res.env"
thread='' source=startup

# A TOML basic string's escapes undone, as Codex reads a `-c` value.
untoml() {
  local s=$1 out='' c
  while [ -n "$s" ]; do
    c=${s:0:1}; s=${s#?}
    if [ "$c" = '\' ]; then
      c=${s:0:1}; s=${s#?}
      case $c in
        n) c=$'\n' ;; t) c=$'\t' ;; r) c=$'\r' ;; b) c=$'\b' ;; f) c=$'\f' ;;
        u) printf -v c "\\$(printf %03o "0x${s:0:4}")"; s=${s:4} ;;
      esac
    fi
    out=$out$c
  done
  printf '%s' "$out"
}

prompt='' model=gpt-5.6-sol mode=default trusted='' titled=''
while [ $# -gt 0 ]; do
  case $1 in
    --) shift; prompt=$*; break ;;
    -c) shift
        case ${1:-} in
          hooks.*=*command=\"*)
            ev=${1#hooks.}; ev=${ev%%=*}; cmd=${1#*command=\"}; cmd=${cmd%\"\}\]\}\]}
            case $ev in *[!A-Za-z]*) ;; *) eval "hook_$ev=\$(untoml \"\$cmd\")" ;; esac ;;
          tui.terminal_title=*) titled=1 ;;
        esac ;;
    resume) shift; thread=${1:-}; source=resume ;;
    -m|--model) shift; model=${1:-} ;;
    -s|-a|-C|--cd|--add-dir|-p|--profile) shift ;;
    --dangerously-bypass-hook-trust) trusted=1 ;;
    --dangerously-bypass-approvals-and-sandbox) mode=bypassPermissions ;;
    -*) ;;
    *) prompt=$1 ;;
  esac
  shift
done

[ -n "$thread" ] || thread=$(uuid)
printf '%s\n' "$thread" > "$STUB_STATE/$res.thread"

# What every payload says, quoted once.
transcript=${CODEX_HOME:-$STUB_STATE/codex}/sessions/$(date +%Y/%m/%d)/rollout-$(date +%Y-%m-%dT%H-%M-%S)-$thread.jsonl
j_transcript=$(json "$transcript")
j_cwd=$(json "$PWD") j_model=$(json "$model")
turn_id=''

# fire <event> [,"more":json]: one hook, as Codex runs it; the fields in Codex's order.
fire() {
  local c p
  [ -n "$trusted" ] || return 0
  eval "c=\${hook_$1:-}"
  [ -n "$c" ] || return 0
  p="{\"session_id\":\"$thread\""
  case $1 in SessionStart|SessionEnd) ;; *) p="$p,\"turn_id\":\"$turn_id\"" ;; esac
  p="$p,\"transcript_path\":\"$j_transcript\",\"cwd\":\"$j_cwd\",\"hook_event_name\":\"$1\""
  [ "$1" = SessionEnd ] || p="$p,\"model\":\"$j_model\",\"permission_mode\":\"$mode\""
  printf '%s%s}' "$p" "${2:-}" | sh -c "$c" >/dev/null
}

esc=$'\033'
glyphs=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
cut="${thread:0:29}..."
ctx=0 glyph=0 spin=''
title() { [ -z "$titled" ] || printf '%s]0;%s\007' "$esc" "$1"; }
# <Ready|Starting|Working> [glyph]
state() { title "$1 | $cut${2:+ $2} | Context $ctx% used"; }

saved=''
[ -t 0 ] && saved=$(stty -g) && stty -icanon -isig -echo -icrnl -ixon min 0 time 1
leave() {
  printf '%s]0;\007%s[<1u%s[<u%s[>4;0m%s[?2004l%s[?1004l' "$esc" "$esc" "$esc" "$esc" "$esc" "$esc"
  [ -z "$saved" ] || stty "$saved" 2>/dev/null
}
trap leave EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM

# The working spell in ticks of 0.1 s.
w=${STUB_WORK:-1} f=0
case $w in *.*) f=${w#*.}; f=${f:0:1}; w=${w%%.*} ;; esac
work=$(( ${w:-0} * 10 + ${f:-0} ))

turn='' left=0 row=1 said='' tool='' draft='' pasting='' pbuf='' taken=0
pend="${esc}[201~"
[ -f "$STUB_STATE/$thread.queue.taken" ] && taken=$(cat "$STUB_STATE/$thread.queue.taken")

submit() {
  if [ -z "$started" ]; then
    started=1
    [ "$source" = resume ] || { mkdir -p "${transcript%/*}"; : >> "$transcript"; }
    fire SessionStart ",\"source\":\"$source\""
  fi
  turn_id=$(uuid) said=$1 spin='' glyph=0
  fire UserPromptSubmit ",\"prompt\":\"$(json "$1")\""
  printf '\n› %s\n' "$1"
  if [ "$1" = /perm ]; then
    turn=perm tool=exec-$(uuid) row=1
    fire PreToolUse ",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"touch stub-perm.txt\"},\"tool_use_id\":\"$tool\""
    fire PermissionRequest ',"tool_name":"Bash","tool_input":{"command":"touch stub-perm.txt","description":"Allow the stub to create stub-perm.txt?"}'
    printf "Would you like to run the following command?\n  \$ touch stub-perm.txt\n› 1. Yes, proceed (y)\n  2. Yes, and don't ask again for these commands\n  3. No, and tell Codex what to do differently (esc)\n"
  else
    turn=work left=$work
  fi
  state Working
}
grant() {
  fire PostToolUse ",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"touch stub-perm.txt\"},\"tool_response\":\"\",\"tool_use_id\":\"$tool\""
  echo "✔ granted"
  turn=work left=$work
}
finish() {
  turn='' ctx=$((ctx + 2))
  fire Stop ",\"stop_hook_active\":false,\"last_assistant_message\":\"$(json "echo: $said")\""
  printf '• echo: %s\n› ' "$said"
  state Working; sleep "${STUB_TAIL:-0.2}"
  state Ready
}
interrupt() {
  turn='' ctx=$((ctx + 2)) spin=1
  : > "$STUB_STATE/$thread.held"
  fire Interrupt
  printf '\n■ Conversation interrupted\n› '
  state Working "${glyphs[glyph]}"; sleep "${STUB_TAIL:-0.2}"
  state Ready "${glyphs[glyph]}"
}
quit() {
  fire SessionEnd ',"reason":"other"'
  printf '\nTo continue this session, run:\n  codex resume %s\n' "$thread"
  exit 0
}

# The next message queued for this thread and not yet run, in $msg; none while it is held.
queued() {
  local n=0
  [ ! -f "$STUB_STATE/$thread.held" ] || return 1
  [ -s "$STUB_STATE/$thread.queue" ] || return 1
  while IFS= read -r -d '' msg; do
    n=$((n + 1))
    [ "$n" -gt "$taken" ] || continue
    taken=$n; echo "$taken" > "$STUB_STATE/$thread.queue.taken"
    return 0
  done < "$STUB_STATE/$thread.queue"
  return 1
}

# Every 0.1 s or so, and after every read: the spinner turns, a turn counts down, an idle
# prompt takes a queued message.
tick() {
  glyph=$(( (glyph + 1) % 10 ))
  case $turn in
    perm) state Working "${glyphs[glyph]}" ;;
    work) state Working "${glyphs[glyph]}"; left=$((left - 1)); [ "$left" -gt 0 ] || finish ;;
    *) [ -z "$spin" ] || state Ready "${glyphs[glyph]}"
       if queued; then submit "$msg"; fi ;;
  esac
}

# One read from the tty, if anything comes within 0.1 s, in $got; logged as it came.
grab() {
  got=$(dd bs=4096 count=1 2>/dev/null; echo x); got=${got%x}
  if [ -n "$got" ]; then printf '%s' "$got" >> "$STUB_STATE/$res.input"; elif [ -z "$saved" ]; then sleep 0.1; fi
}

key_esc() { case $turn in perm|work) interrupt ;; esac; }
key_ctrlc() {
  if [ -n "$turn" ]; then interrupt
  elif [ -n "$draft" ]; then draft=''; printf '\n› '
  else quit; fi
}
key_enter() {
  local d=$draft
  case $turn in
    perm) if [ "$row" = 3 ]; then interrupt; else grant; fi ;;
    work) ;;
    *) [ -n "$d" ] || return 0
       draft=''
       [ "$d" = /exit ] && quit
       rm -f "$STUB_STATE/$thread.held"
       submit "$d" ;;
  esac
}
add() { draft=$draft$1; printf '%s' "$1"; }

# A CSI sequence: kitty keys, a paste's start, arrows in an approval; focus reports and the rest
# mean nothing here.
csi() {
  local code=${1%%;*} mods=''
  code=${code%%:*}
  case $1 in *';'*) mods=${1#*;}; mods=${mods%%:*} ;; esac
  case $2:$code:$mods in
    '~:200:') pasting=1 ;;
    u:27:*) key_esc ;;
    u:13:*) key_enter ;;
    u:99:5) key_ctrlc ;;
    A::) [ "$turn" != perm ] || [ "$row" = 1 ] || row=$((row - 1)) ;;
    B::) [ "$turn" != perm ] || [ "$row" = 3 ] || row=$((row + 1)) ;;
  esac
}

keys() {
  local rest=$1 c body params fin
  while [ -n "$rest" ]; do
    if [ -n "$pasting" ]; then
      pbuf=$pbuf$rest rest=''
      case $pbuf in *"$pend"*) add "${pbuf%%"$pend"*}"; rest=${pbuf#*"$pend"} pbuf='' pasting='' ;; esac
      continue
    fi
    c=${rest:0:1} rest=${rest#?}
    case $c in
      "$esc")
        if [ -z "$rest" ]; then grab; rest=$got; [ -n "$rest" ] || { key_esc; continue; }; fi
        case $rest in
          '['*) body=${rest#?}; params=${body%%[!0-9:;?<>=]*}; fin=${body:${#params}:1}
                if [ -z "$fin" ]; then grab; if [ -n "$got" ]; then rest="$esc$rest$got"; else rest=''; fi; continue; fi
                rest=${body:$((${#params} + 1))}
                csi "$params" "$fin" ;;
          O*) fin=${rest:1:1}; rest=${rest#??}; csi '' "$fin" ;;
          *) key_esc ;;
        esac ;;
      $'\003') key_ctrlc ;;
      $'\r') key_enter ;;
      $'\177'|$'\b') [ -z "$draft" ] || { draft=${draft%?}; printf '\b \b'; } ;;
      *) case $turn in
           perm) case $c in y) grant ;; n) interrupt ;; esac ;;
           *) case $c in [[:cntrl:]]) [ "$c" = $'\n' ] && add "$c" ;; *) add "$c" ;; esac ;;
         esac ;;
    esac
  done
}

# What Codex pushes: bracketed paste, modifyOtherKeys off, kitty flags 5, focus reports.
printf '%s[?2004h%s[>4;0m%s[>5u%s[?1004h' "$esc" "$esc" "$esc" "$esc"
printf 'stub-codex %s (%s)%s\n' "$res" "$thread" "${source#startup}"
started=''
title "Ready | Context 0% used"; sleep 0.2
state Ready; sleep 0.2
state Starting; sleep 0.2
if [ -n "$prompt" ]; then submit "$prompt"; else state Ready; printf '› '; fi
: > "$STUB_STATE/$res.ready"
while :; do
  grab
  [ -z "$got" ] || keys "$got"
  tick
done
